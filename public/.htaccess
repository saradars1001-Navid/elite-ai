<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # Never let the SPA swallow API routes (useful when the API shares a domain).
    RewriteRule ^api/ - [L]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.html [L]
</IfModule>
