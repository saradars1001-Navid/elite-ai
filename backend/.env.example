[TEMPLATE]
APP_NAME="Elite AI Academy API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elite_ai
DB_USERNAME=elite_ai_user
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
SANCTUM_STATEFUL_DOMAINS=app.example.com
FRONTEND_URL=https://app.example.com
OTP_DRIVER=twilio
OTP_TEST_MODE=false
OTP_LENGTH=5
OTP_TTL_MINUTES=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=
ADMIN_BOOTSTRAP_TOKEN=

# اعلان پیامکی رویدادها (پرداخت / بازگشت وجه) — true یعنی ارسال شود
NOTIFY_SMS_ENABLED=false

# درگاه پرداخت — PAYMENT_GATEWAY: zarinpal (پیش‌فرض) یا idpay
PAYMENT_GATEWAY=zarinpal

# زرین‌پال
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# آیدی‌پی (IDPay v1.1)
IDPAY_API_KEY=
IDPAY_SANDBOX=true

# وب‌هوک سرور-به-سرور
# ۱) رمز اشتراکی ساده — درگاه آن را در هدر X-Webhook-Secret ارسال می‌کند (اختیاری)
PAYMENT_WEBHOOK_SECRET=
# ۲) تأیید امضای HMAC روی بدنه خام — برای درگاه‌هایی که امضا می‌کنند (مثل زیبال)
#    signature = hash_hmac(WEBHOOK_HMAC_ALGO, rawBody, WEBHOOK_HMAC_SECRET)
WEBHOOK_HMAC_SECRET=
WEBHOOK_HMAC_HEADER=X-Signature
WEBHOOK_HMAC_ALGO=sha256
# راز اختصاصی درگاه آیدی‌پی (اگر فقط برای آیدی‌پی امضا دارید؛ خالی = غیرفعال)
IDPAY_WEBHOOK_SECRET=
