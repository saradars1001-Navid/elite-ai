[TEMPLATE]
# ── Laravel API (production preferred) ─────────────────────────────────────
# Example: https://api.example.com/api/v1
# When set, auth, catalog, quiz scoring, real-user search and discovery use Laravel/MySQL.
VITE_API_BASE_URL=

# ── Supabase (optional legacy backend) ─────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The frontend never receives database credentials, APP_KEY, service-role keys,
# Twilio secrets or payment secrets. Those belong only in backend/.env.
